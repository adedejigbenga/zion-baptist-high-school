# Placeholders only. Copy this file to .env.local and fill in real values.
# .env.local and every other .env* file (except this one) are git-ignored. Never commit secrets.
# Only variables prefixed NEXT_PUBLIC_ are sent to the browser. Everything else stays server-side.

# --- Database (PostgreSQL, hosted separately from Vercel) ---
# Runtime connection string used by the app (use the provider's pooled URL on serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional: direct (non-pooled) URL for migrations, if the provider separates the two.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Authentication (to be configured in the authentication step) ---
# Long random string used to sign/encrypt sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Application ---
# Public base URL of the site (http://localhost:3000 locally, the real domain in production).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
